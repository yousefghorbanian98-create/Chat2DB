{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyClip Desktop",
  "version": "0.2.0",
  "identifier": "ai.easyclip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyClip Desktop",
        "width": 1360,
        "height": 850,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Local AI video clipping studio",
    "longDescription": "Create Persian and English captioned vertical clips from your videos using local AI.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "resources/": ""
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Persian"],
        "displayLanguageSelector": true
      }
    }
  }
}
