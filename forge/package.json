{
  "name": "forge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ssr": "esbuild src/ssr-entry.tsx --bundle --platform=node --format=esm --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --external:react-dom/server --outfile=dist-ssr/app.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "design-gate": "node scripts/design-gate.mjs",
    "test": "npm run build:ssr && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
