# این فایل را کپی کنید به .env و کلید خودتان را جایگزین کنید:
#   cp .env.example .env
#
# کلید را از Google Cloud Console بگیرید:
#   console.cloud.google.com → New Project → APIs & Services → Library
#   → «YouTube Data API v3» → Enable → Credentials → Create Credentials → API key

YOUTUBE_API_KEY=

# پورتی که سایت روی آن بالا می‌آید
PORT=3000
