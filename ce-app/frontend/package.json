{
  "name": "cutting-edge-frontend",
  "version": "0.2.0",
  "description": "Cutting Edge (CE) — AI-powered video clipping studio",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "antd": "^5.19.0",
    "@ant-design/icons": "^5.4.0",
    "axios": "^1.7.4",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4",
    "@tanstack/react-query": "^5.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.4.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.cuttingedge.studio",
    "productName": "Cutting Edge",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      { "from": "../build/backend", "to": "backend" },
      { "from": "../build/ffmpeg", "to": "ffmpeg" }
    ],
    "publish": {
      "provider": "github",
      "owner": "yousefghorbanian98-create",
      "repo": "Cutting-Edge-Studio",
      "private": false
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}